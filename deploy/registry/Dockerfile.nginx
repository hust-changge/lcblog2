FROM node:22-alpine AS frontend
WORKDIR /build
COPY B1gchangBlog-Frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY B1gchangBlog-Frontend/ ./
RUN npm run build
FROM node:22-alpine AS admin
WORKDIR /build
COPY B1gchangBlog-AdminPanel/package*.json ./
RUN npm ci --no-audit --no-fund
COPY B1gchangBlog-AdminPanel/ ./
RUN npm run build
FROM nginx:stable-alpine
COPY deploy/registry/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend /build/dist/ /usr/share/nginx/html/
COPY --from=admin /build/dist/ /usr/share/nginx/html/admin/
